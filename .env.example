# Supabase Postgres (use the pooler connection string, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (customers). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Root admin account, created on first start (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
