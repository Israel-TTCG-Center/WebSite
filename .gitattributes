# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF for web, config, and container files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles & generated files (collapse diffs on GitHub/GitLab)
pnpm-lock.yaml text eol=lf linguist-generated=true -diff
package-lock.json text eol=lf linguist-generated=true -diff
yarn.lock text eol=lf linguist-generated=true -diff

# SVG is XML text
*.svg text eol=lf

# Binary assets (do not modify line endings or attempt text diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
